{
  "Lua.runtime.version": "Lua 5.1",
  "Lua.diagnostics.globals": [
    "SLASH_HELLOFOREVER1",
    "SLASH_HELLOFOREVER2",
    "SlashCmdList",
    "FauxScrollFrame_Update",
    "APIDocumentation",
    "NUM_BAG_SLOTS",
    "BACKPACK_CONTAINER",
    "DEFAULT_CHAT_FRAME"
  ],
  "Lua.workspace.library": [
    "types",
