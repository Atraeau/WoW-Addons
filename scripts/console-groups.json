    { "name": "Action bars, bindings and keys", "blurb": "Action bar behaviour, key bindings and the cast bar.",
      "match": ["^ActionBar", "^actionBar", "^ActionButton", "^lockActionBars", "^autoSelfCast", "^AutoPushSpell", "^autoFilledMultiCast", "^synchronizeBindings", "^synchronizeConfig", "^synchronizeMacros", "^bindings", "^keybind", "^countdownForCooldowns", "^cooldown", "^showTargetCastbar", "^IgnoreCooldown", "^enableMultiActionBars", "^multiBar", "^secureAbility", "^PreemptiveCast", "^enableRune", "^runeFade", "^runeSpent", "^stopAutoAttack", "^autoUnshift", "^doubleTap", "^UseKeyHeldSpell", "^empowerTap", "^EmpowerTap", "^EmpowerMin"] },
