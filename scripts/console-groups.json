    { "name": "Targeting and combat", "blurb": "Targeting rules, soft target, auto attack, combat behaviour and pings.",
      "match": ["^softTarget", "^autoAttack", "^autoRangedCombat", "^target", "^Target", "^stickyTargeting", "^assist", "^AsyncAssist", "^combat", "^deselectOnClick", "^autoInteract", "^interactOn", "^spell", "^Spell", "^attack", "^enemy", "^friendly", "^UnitEnterCombat", "^autoDismount", "^autoClearAFK", "^pingTarget", "^pingMode", "^ping", "^enablePings", "^superTrackerDist", "^ImpactModelCollision", "^displayWorldPVPObjectives", "^enablePVPNotifyAFK", "^pvpSelectedRoles", "^AllowSpectateMode"] },
    { "name": "Loot, bags, bank and items", "blurb": "Looting, bags, the bank, vendors, the auction house, comparing and displaying items.",
      "match": ["loot", "Loot", "^autoLoot", "^bag", "^Bag", "^bank", "^combinedBags", "^expandBagBar", "^expandUpgradePanel", "^expandWarbandCharacterList", "^inventory", "^vendor", "^auction", "^Auction", "^item", "^Item", "^sell", "^sortBags", "^reverseCleanupBags", "^insertItems", "^showItem", "^ReagentBank", "^reagent", "^craft", "^crafting", "^profession", "^primaryProfessions", "^secondaryProfessionsFilter", "^serviceTypeFilter", "^trade", "^cloakFixEnabled", "^equipment", "^upgrade", "^socket", "^alwaysCompareItems", "^allowCompareWithToggle", "^dontShowEquipmentSetsOnItems", "^deemphasizeOffspecPrimaryStats", "^categorizeTrainerUI", "^missingTransmogSource"] },
