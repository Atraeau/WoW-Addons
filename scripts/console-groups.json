{
  "_about": "How scripts/generate-console-docs.ps1 sorts the client's console list into topics. The client's own categories are too coarse (graphics settings sit in 'Default', 'Game' holds 1,100 unrelated things), so a setting is placed by its name. The first group whose 'match' (a regular expression on the name, case-insensitive) fits wins, so order matters: specific groups come before general ones. Anything unmatched goes to 'fallback'. A real console command (not a setting) always goes to 'commands'. To move a setting, add or reorder a pattern here and run the generator again. The order topics are shown in the generated page is the 'display' list below; the order of 'groups' is only the order patterns are tried.",
  "commands": { "name": "Console commands", "blurb": "Things you type that do something, rather than settings: `/console <name>`." },
  "fallback": { "name": "Other settings", "blurb": "Settings that fit no topic above." },
  "display": ["Console commands", "Graphics: quality presets", "Graphics: display and window", "Sound and voice", "Camera", "Mouse and cursor", "Gamepad", "Accessibility", "Interface and maps", "Nameplates, unit frames and highlights", "Floating text and combat text", "Chat and social", "Action bars, bindings and keys", "Targeting and combat", "Movement and controls", "Combat alerts and encounter info", "Loot, bags, bank and items", "Collections: pets, mounts, toys and wardrobe", "Quests, journals and progression", "Calendar, clock and events", "Housing and neighbourhoods", "Network and connection", "Account, login and region", "Screenshots and sharing", "Integrations", "Graphics: hardware and engine internals", "Camera: fine tuning", "Game data, cache and loading", "World and physics", "Tutorials and first-time hints", "Addons, errors and scripting", "Debugging and logging"],
  "groups": [
    { "name": "Addons, errors and scripting", "blurb": "Lua errors and warnings, addon loading, the frame stack (fstack) and the developer log filters.",
      "match": ["^disableUILoadErrorDialog", "^ErrorFilter", "^ErrorLevel", "^Errors$", "^scriptWarnings", "^scriptErrors", "^luaErrorExceptions", "^validateFrameXML", "^checkAddonVersion", "^disableUserAddonsByDefault", "^loadDeprecationFallbacks", "^fstack", "^developerLog", "^enableSourceLocationLookup", "^consoleShowSpamMessages", "^ConsoleKey", "^DeprecatedWarningThrottle", "^taintLog", "^scriptProfile", "^addon", "^Addon", "^loadAddons", "^enableAddOns", "^overrideArchive", "^hotReload", "^showErrors", "^frameScript"] },
    { "name": "Debugging and logging", "blurb": "Developer switches and event logs. Most do nothing useful on a live game.",
      "match": ["^enableAssetTracking", "EventLog", "Debugger", "^debug", "Debug", "Visualizer", "^AI(Brain|Controller|EventLog)", "BehaviorTree", "Verbose", "^PlayerSpawnTracking$", "Trace", "ValidationLog", "History$", "ActionsLog", "(?-i:^Log)", "(?-i:Log$)", "^(AreaTriggers|Collision|Pathing|ContentTuning|DamageCalculator|HealHandler|GameplayContext|SpellOverrides|SpellVisuals|SpellTargeting|UnitVisibility|SpawnRegion|simd|ProcDebug)$", "^cvar(_|list)", "^(ver|set|quit|logout)$", "telemetry", "^InvalidateDeactivatedHandles", "^BlizzCon", "^engineSurvey", "^agentUID", "^allowDevPublicKey", "^bodyQuota", "^asyncHandlerTimeout", "^asyncThreadSleep"] },
    { "name": "Gamepad", "blurb": "Controller support: cursor, camera, buttons and vibration.",
      "match": ["^GamePad", "^SmartNavigation", "^enableMovePad", "^InputDeviceInterfaceStyle", "^DriveSwapReverseTurnDirection", "^DriveDynamicFOVEnabled"] },
    { "name": "Camera: fine tuning", "blurb": "Internal camera smoothing, terrain and pivot constants (including the test_ camera options). Leave these alone unless you know why.",
      "match": ["^camera(Terrain|Smooth|ZSmooth|YawSmooth|PitchSmooth|Pivot|Indirect|Dive|Ground|Height|WaterCollision|Submerge|Surface|TargetSmooth|CustomViewSmoothing|Reduce|OverShoulder|Saved)", "^test_camera"] },
    { "name": "Camera", "blurb": "How far the camera zooms, its field of view, follow style and bobbing.",
      "match": ["^camera", "ActionCombatCamera", "^pitchLimit", "^yawMoveSpeed", "^pitchMoveSpeed", "^CameraKeepCharacterCentered", "^CameraFollow", "^CameraReduce"] },
    { "name": "Mouse and cursor", "blurb": "Mouse speed, look and cursor behaviour.",
      "match": ["^cursor", "^ClipCursor", "^mouse", "^enableWowMouse", "freelook", "^enableMouse", "^rawMouseEnable", "^HardwareCursor", "^enableMouseoverCast"] },
    { "name": "Sound and voice", "blurb": "Volume, channels, music, ambience, voice chat.",
      "match": ["^Sound", "^audio", "^voice", "Voice", "^music", "^ambience", "^EnableMusic", "^EnableSound", "^EnableAmbience", "^MasterSoundEffects", "^FootstepSounds", "^PushToTalk", "^threatPlaySounds"] },
    { "name": "Accessibility", "blurb": "Colour-blind modes, text to speech, combat audio alerts, reducing motion, flashing and effects.",
      "match": ["colorblind", "^daltonize", "^TTS", "^tts", "^winePlatformTTS", "Accessib", "speechTo", "reduceMotion", "ShakeStrength", "textToSpeech", "^CAA(?!Resource)", "^arachnophobia", "^motionSickness", "^doNotFlash", "^screenEdgeFlash", "^overrideScreenFlash", "^flashErrorMessageRepeats", "^violenceLevel"] },
    { "name": "Graphics: display and window", "blurb": "Resolution, monitor, fullscreen or windowed, vsync, frame-rate limits, window title bar, HDR output.",
      "match": ["^Gx(Fullscreen|Windowed|New)?Resolution", "^GxMonitor", "^GxMaximize", "^GxApi", "^GxMaxFrameLatency", "^vsync", "^maxfps", "^useMaxFPS", "^useTargetFPS", "^ExclusiveWindowMode", "^ForceResolution", "^Notched", "^windowResizeLock", "^WindowedMode", "^gxWindow", "^fullscreen", "^hideFastLogin", "^titleBar", "^reloadUIOnAspectChange", "^ResizeConstraints", "^displayFrequency", "^refreshRate", "^hdrDisplay", "^useHDR", "^videoOptionsVersion", "^DynamicRenderScale", "^renderScale", "^RenderFormat", "^targetFPS"] },
    { "name": "Graphics: hardware and engine internals", "blurb": "Per-GPU and per-API feature switches, shader and threading options, loading jobs. Rarely worth changing by hand.",
      "match": ["^ClientSettings_", "^GxCompat", "^Gx", "^gx", "^CAAResource", "ThreadPool", "Shader", "Async(Compute|Shader)", "LowLatency", "^CMD", "Microcode", "RayTracing", "^dx", "^hwDetect", "^MTOpaque", "^SM6", "^gpu", "^CTex", "HighMem", "Vram", "^Rgb10", "^WorkSubmit", "^M2", "^MaxObserved", "^physics?Cull", "^shaderLoad", "^textureCache", "^AllowSoftwareRenderer", "^DriverVersionCheck", "^forceClusteredShading", "^clusteredShading", "MaxJobs$", "^MaxCharacterComponentLoad", "^component(Thread|TexCache|TexLoadLimit|Compress)", "^dnMTUpdate", "^disableServerNagle", "^SplineOpt", "^sortDiskReads", "^forceLODCheck", "^FrameBuffer"] },
    { "name": "Graphics: quality presets", "blurb": "The settings the in-game Graphics panel sets, one per option, with a separate copy for raid groups (the RAID and raidGraphics names). Also textures, lighting, fog and levels of detail.",
      "match": ["^specular", "^(raid)?graphics", "(?-i:^RAID)", "^giQuality", "^shadow", "^SSAO", "^assao", "^CMAA2", "^sunShafts", "^projectedTextures", "^particle", "^lod", "^terrain", "^water", "^liquid", "^pbrLiquid", "^reflection", "^refraction", "^ripple", "^weather", "^groundEffect", "^horizon", "^farclip", "^nearclip", "^entityShadow", "^entityLod", "^spellClutter", "^unitClutter", "^ffx", "^textureFiltering", "^MSAA", "^brightness", "^contrast", "^gamma", "^bloom", "^Outline", "^depthBasedOpacity", "^ObjectFade", "^sky", "^clouds?", "^fog", "^volumeFog", "^hdr", "^colorGrading", "^wmoLod", "^wmoDoodad", "^wmoPortal", "^TextureResolution", "^viewDistance", "^resample", "^foliage", "^grass", "^detail", "^trilinear", "^anisotropic", "^Sharpen", "^FSR", "^dlss", "^xess", "^volumetric", "^mapRender", "^component", "^doodadLod", "^dynamicLod", "^animFrameSkipLOD", "^linear$", "^maxLight", "^outdoorMinAltitude", "^useHighResTextures", "^vrs", "^worldBaseMip", "^worldPreloadHighRes", "^SlugOpticalWeight", "^UseSlug", "^ForceGenerateSlug", "^textureErrorColors", "^sceneOcclusionEnable", "^disableHorizonStart", "^sceneOcc", "^light", "^particulates"] },
    { "name": "Combat alerts and encounter info", "blurb": "Loss of control icons, threat, the encounter timeline and warnings, external defensives.",
      "match": ["^lossOfControl", "^threat", "^encounterTimeline", "^encounterWarnings", "^externalDefensives", "^commentator", "^useCommentator", "^damageMeter", "^advancedCombatLogging"] },
    { "name": "Nameplates, unit frames and highlights", "blurb": "Name plates, unit frames, \"find yourself\" highlights and similar over-the-head display.",
      "match": ["^nameplate", "^UnitNameplate", "^UnitName", "^UnitSurname", "^showTargetOfTarget", "^buffDurations", "^noBuffDebuff", "^playerColorOverride", "^raidFrame", "^partyBackground", "^useCompactPartyFrames", "^pvpFrame", "^showPartyBackground", "^ObjectSelectionCircle", "^findYourself", "^unitsLookAtPlayers", "^unitFacingPlayerDeadZoneDeg", "^useCommentatorSelectionCircles", "^ReplaceMyPlayerPortrait", "^ReplaceOtherPlayerPortraits", "^emphasizeMySpellEffects", "^displaySpellActivationOverlays", "^alwaysShowRuneIcons", "^comboPointLocation", "^collapseExpandBuffs", "^pvpOptionDisplayPets", "^displayTemporaryEnchantIcon"] },
    { "name": "Floating text and combat text", "blurb": "Damage and healing numbers, world text, and the combat log.",
      "match": ["^floatingCombatText", "^WorldText", "^combatDamage", "^combatHealing", "^enableFloatingCombatText", "^enablePetBattleFloatingCombatText", "^CombatText", "^combatLog", "^CombatLog", "^spellDamage", "^damageText", "^NonEmitterCombat", "^EmitterCombat", "^classicStyleWorldText"] },
    { "name": "Chat and social", "blurb": "Chat frames, whispers, chat style, friends, guild and community options, the profanity filter.",
